#!/usr/bin/env python3
"""Run Codex threads in the background without losing track of them.

    cx run NAME --brief FILE [--model M] [--effort E] [--sandbox S] [--cd DIR]
                             [--timeout MIN] [--worktree]
    cx resume NAME MESSAGE [--sandbox S] [--timeout MIN]
    cx watch [NAME...] [--for MIN] milestones, then one summary line every 3 min;
                                   no names: all running threads, and new ones
    cx status [NAME...]            one line per thread
    cx result NAME                 the thread's final message

Each thread lives in $CX_HOME/NAME (default /tmp/cx-threads): brief.md,
events.jsonl, result.md, stderr.log, progress.log and state.json. `run` and
`resume` block until Codex ends, so start them with the harness's background
mode: the harness reports the exit itself, and a crashed or hung thread cannot
go unnoticed. The wrapper holds `lock` for its whole life; a thread marked
running whose lock is free lost its wrapper and is reported as killed.
"""

import argparse
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

HOME = Path(os.environ.get("CX_HOME", "/tmp/cx-threads")).resolve()
ENDED = {"done", "failed", "timeout", "killed"}
SUMMARY_EVERY = 180  # watch: seconds between summary lines, to not flood the chat
QUIET_WARNING = 600  # flag a running thread that has emitted nothing for this long
# Codex runs every command as `/usr/bin/zsh -lc '...'`; show only the command.
SHELL_WRAPPER = re.compile(r"^\S*\b(?:zsh|bash|sh) -l?c ")
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")


def thread_dir(name: str) -> Path:
    if not NAME.match(name):
        sys.exit(f"cx: bad thread name {name!r} (letters, digits, . _ - only)")
    return HOME / name


def read_state(name: str) -> dict:
    try:
        return json.loads((thread_dir(name) / "state.json").read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def write_state(name: str, **changes) -> dict:
    state = {**read_state(name), **changes}
    path = thread_dir(name) / "state.json"
    tmp = path.with_suffix(f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(state, indent=2))
    tmp.replace(path)
    return state


def log(name: str, line: str) -> None:
    with open(thread_dir(name) / "progress.log", "a") as f:
        f.write(f"{time.strftime('%H:%M:%S')} {line}\n")


def describe(event: dict) -> str | None:
    """One progress line for an event worth reporting, else None."""
    kind = event.get("type")
    item = event.get("item") or {}
    if kind == "item.started" and item.get("type") == "command_execution":
        return "$ " + SHELL_WRAPPER.sub("", item.get("command", "")).strip("'\"")[:120]
    if kind == "item.completed" and item.get("type") == "file_change":
        paths = ", ".join(c.get("path", "?") for c in item.get("changes", []))[:160]
        failed = item.get("status") not in (None, "completed")
        return f"{'failed edit' if failed else 'edited'} {paths}"
    if kind == "turn.failed":
        return "error: " + str((event.get("error") or {}).get("message", ""))[:200]
    if kind == "error":
        return "error: " + str(event.get("message", ""))[:200]
    return None


def hold_lock(name: str):
    """Take the thread's lock for this process's life, or exit if it is taken."""
    lock = open(thread_dir(name) / "lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit(f"cx: {name} is already running")
    return lock


def lock_is_held(name: str) -> bool:
    try:
        with open(thread_dir(name) / "lock") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
    except FileNotFoundError:
        return False
    except BlockingIOError:
        return True


def die_with_parent() -> None:
    """Stop Codex if this wrapper is killed, so no thread runs unsupervised."""
    if sys.platform == "linux":
        import ctypes
        PR_SET_PDEATHSIG = 1
        ctypes.CDLL(None, use_errno=True).prctl(PR_SET_PDEATHSIG, int(signal.SIGTERM))


def kill_group(pgid: int, sig: signal.Signals) -> None:
    try:
        os.killpg(pgid, sig)
    except ProcessLookupError:
        pass


def execute(name: str, command: list[str], stdin_path: Path | None, timeout_min: float) -> int:
    folder = thread_dir(name)
    started = time.time()
    write_state(name, state="running", started=started, last_event=None, ended=None, exit=None)
    log(name, "started")
    state, code = "failed", None
    try:
        stdin = open(stdin_path) if stdin_path else subprocess.DEVNULL
        with open(folder / "events.jsonl", "a") as events, open(folder / "stderr.log", "a") as err:
            # Its own process group, so a timeout also stops the commands it started.
            process = subprocess.Popen(
                command, stdin=stdin, stdout=subprocess.PIPE, stderr=err, text=True,
                start_new_session=True, preexec_fn=die_with_parent,
            )
            # A timer rather than a check between events: a hung Codex emits nothing.
            timed_out = threading.Event()

            def expire() -> None:
                timed_out.set()
                kill_group(process.pid, signal.SIGTERM)

            timer = threading.Timer(timeout_min * 60, expire)
            timer.daemon = True
            timer.start()
            failed = False
            for line in process.stdout:
                events.write(line)
                events.flush()
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if event.get("type") == "thread.started":
                    write_state(name, thread_id=event.get("thread_id"))
                failed |= event.get("type") == "turn.failed"
                write_state(name, last_event=time.time())
                if (text := describe(event)) is not None:
                    log(name, text)
            code = process.wait()
            timer.cancel()
            if timed_out.is_set():
                # SIGTERM may leave the commands Codex started behind.
                time.sleep(2)
                kill_group(process.pid, signal.SIGKILL)
        if timed_out.is_set():
            state = "timeout"
        elif code == 0 and not failed and (folder / "result.md").exists():
            state = "done"
    except Exception as error:
        log(name, f"error: wrapper crashed: {error!r}")
        raise
    finally:
        minutes = (time.time() - started) / 60
        write_state(name, state=state, exit=code, ended=time.time())
        log(name, f"{state} after {minutes:.1f} min (exit {code})")
    where = folder / "result.md" if state == "done" else folder / "progress.log"
    print(f"{name}: {state} after {minutes:.1f} min, see {where}")
    return 0 if state == "done" else 1


def cmd_run(args) -> int:
    folder = thread_dir(args.name)
    folder.mkdir(parents=True, exist_ok=True)
    lock = hold_lock(args.name)  # noqa: F841 - held until the process exits
    for stale in ("result.md", "result.previous.md", "progress.log", "events.jsonl",
                  "stderr.log", "state.json"):
        (folder / stale).unlink(missing_ok=True)
    brief = folder / "brief.md"
    brief.write_text(Path(args.brief).read_text())
    cd = str(Path(args.cd).resolve())
    command = [
        "codex", "exec", "-m", args.model, "-c", f'model_reasoning_effort="{args.effort}"',
        # Unattended: anything needing approval is refused instead of waiting forever.
        "-c", 'approval_policy="never"',
        "-s", args.sandbox, "-C", cd, "--json", "--skip-git-repo-check",
        "-o", str(folder / "result.md"),
    ]
    if args.worktree:
        command.append("--worktree")
    write_state(args.name, model=args.model, effort=args.effort, sandbox=args.sandbox, cd=cd)
    return execute(args.name, [*command, "-"], brief, args.timeout)


def cmd_resume(args) -> int:
    folder = thread_dir(args.name)
    lock = hold_lock(args.name)  # noqa: F841 - held until the process exits
    state = read_state(args.name)
    if not state.get("thread_id"):
        sys.exit(f"cx: no thread id recorded for {args.name}")
    if (folder / "result.md").exists():
        (folder / "result.md").replace(folder / "result.previous.md")
    sandbox = args.sandbox or state.get("sandbox", "read-only")
    write_state(args.name, sandbox=sandbox)
    # resume has no -s or -C: the sandbox goes through -c, and the working
    # directory is the process's own.
    os.chdir(state["cd"])
    command = [
        "codex", "exec", "resume", state["thread_id"], "--json", "--skip-git-repo-check",
        "-c", f'sandbox_mode="{sandbox}"', "-c", 'approval_policy="never"',
        "-o", str(folder / "result.md"), args.message,
    ]
    return execute(args.name, command, None, args.timeout)


def current(name: str) -> dict:
    """State, with a running thread whose wrapper died marked as killed."""
    state = read_state(name)
    if state.get("state") == "running" and not lock_is_held(name):
        state = write_state(name, state="killed", ended=time.time())
        log(name, "killed (its wrapper is gone)")
    return state


def status_line(name: str) -> str:
    state = current(name)
    if not state.get("state"):
        return f"{name}: unknown"
    now = time.time()
    started = state.get("started", now)
    minutes = ((state.get("ended") or now) - started) / 60
    progress = thread_dir(name) / "progress.log"
    lines = progress.read_text().splitlines() if progress.exists() else []
    commands = sum(" $ " in line for line in lines)
    edits = sum(" edited " in line for line in lines)
    last = lines[-1][9:] if lines else ""
    note = ""
    quiet = now - (state.get("last_event") or started)
    if state["state"] == "running" and quiet > QUIET_WARNING:
        note = f" [silent {quiet / 60:.0f} min]"
    return (f"{name}: {state['state']} {minutes:.0f} min, {commands} commands, "
            f"{edits} edits{note}; last: {last[:90]}")


def cmd_status(args) -> int:
    names = args.names or (sorted(p.name for p in HOME.iterdir() if p.is_dir()) if HOME.exists() else [])
    for name in names:
        print(status_line(name))
    return 0


def running_threads() -> list[str]:
    if not HOME.exists():
        return []
    return sorted(p.name for p in HOME.iterdir()
                  if p.is_dir() and current(p.name).get("state") == "running")


def cmd_watch(args) -> int:
    # Without names, follow every running thread, including ones started later.
    follow_all = not args.names
    names = list(dict.fromkeys(args.names)) if args.names else running_threads()
    for name in names:
        print(status_line(name), flush=True)
    # Start at the end of each log: a re-armed watch must not replay history.
    offsets = {}
    for name in names:
        progress = thread_dir(name) / "progress.log"
        offsets[name] = progress.stat().st_size if progress.exists() else 0
    ended = {name for name in names if current(name).get("state") in ENDED}
    watch_started = time.time()
    deadline = watch_started + args.minutes * 60
    last_summary = time.time()
    while len(ended) < len(names) or (follow_all and not names):
        if follow_all:
            for name in running_threads():
                if name not in names:
                    names.append(name)
                    offsets[name] = 0
        if follow_all and not names and time.time() > watch_started + 60:
            print("no threads running", flush=True)
            return 0
        for name in names:
            if name in ended:
                continue
            progress = thread_dir(name) / "progress.log"
            if progress.exists():
                with open(progress) as f:
                    f.seek(offsets[name])
                    for line in f:
                        text = line[9:].rstrip()
                        if text == "started" or text.startswith(("error", "failed edit")):
                            print(f"{name}: {text}", flush=True)
                    offsets[name] = f.tell()
            state = current(name).get("state")
            # A thread launched together with the watch may not have written its state yet.
            if state in ENDED or (state is None and time.time() - watch_started > 60):
                print(status_line(name), flush=True)
                ended.add(name)
        running = [name for name in names if name not in ended]
        if running and time.time() - last_summary > SUMMARY_EVERY:
            print(" | ".join(status_line(name) for name in running), flush=True)
            last_summary = time.time()
        if running and time.time() > deadline:
            print(f"watch window over, still running: {' '.join(running)} (re-arm the watch)",
                  flush=True)
            return 0
        time.sleep(2)
    return 0


def cmd_result(args) -> int:
    path = thread_dir(args.name) / "result.md"
    if not path.exists():
        sys.exit(f"cx: no result for {args.name} ({current(args.name).get('state', 'unknown')})")
    print(path.read_text())
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="cx", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    run = sub.add_parser("run")
    run.add_argument("name")
    run.add_argument("--brief", required=True)
    run.add_argument("--model", default="gpt-6-sol")
    run.add_argument("--effort", default="high")
    run.add_argument("--sandbox", default="read-only", choices=["read-only", "workspace-write"])
    run.add_argument("--cd", default=".")
    run.add_argument("--timeout", type=float, default=60, help="minutes")
    run.add_argument("--worktree", action="store_true")
    run.set_defaults(func=cmd_run)

    resume = sub.add_parser("resume")
    resume.add_argument("name")
    resume.add_argument("message")
    resume.add_argument("--sandbox", choices=["read-only", "workspace-write"])
    resume.add_argument("--timeout", type=float, default=60, help="minutes")
    resume.set_defaults(func=cmd_resume)

    watch = sub.add_parser("watch")
    watch.add_argument("names", nargs="*", help="default: every running thread, and new ones")
    watch.add_argument("--for", dest="minutes", type=float, default=25,
                       help="minutes before the watch ends itself (Monitor allows 30)")
    watch.set_defaults(func=cmd_watch)

    status = sub.add_parser("status")
    status.add_argument("names", nargs="*")
    status.set_defaults(func=cmd_status)

    result = sub.add_parser("result")
    result.add_argument("name")
    result.set_defaults(func=cmd_result)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
